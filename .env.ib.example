# Interactive Brokers MCP Server Configuration
# Copy this file to .env.ib and fill in your credentials
# IMPORTANT: Never commit .env.ib to version control!

# ============================================
# Authentication Settings
# ============================================

# Your Interactive Brokers username
IB_USERNAME=your_username_here

# Your Interactive Brokers password
IB_PASSWORD_AUTH=your_password_here

# ============================================
# Connection Settings
# ============================================

# Use headless mode (true) or browser OAuth (false)
# Headless mode: automatically logs in without browser
# Browser mode: opens browser for OAuth flow (recommended for 2FA)
IB_HEADLESS_MODE=false

# Paper trading mode (recommended for testing)
# Set to "true" for paper trading, "false" for live trading
# WARNING: Live trading involves real financial risk!
IB_PAPER_TRADING=true

# Authentication timeout in milliseconds (default: 300000 = 5 minutes)
IB_AUTH_TIMEOUT=300000

# ============================================
# Gateway Settings (Advanced)
# ============================================

# IB Gateway host (default: localhost)
# IB_GATEWAY_HOST=localhost

# IB Gateway port (auto-configured based on paper/live trading)
# Paper trading: 4002
# Live trading: 4001
# IB_GATEWAY_PORT=4002

# ============================================
# Security Notes
# ============================================
#
# 1. NEVER share your credentials or commit them to git
# 2. Always test with paper trading first
# 3. Enable two-factor authentication on your IB account
# 4. Only run this server on trusted, local machines
# 5. Review all trades before execution
#
